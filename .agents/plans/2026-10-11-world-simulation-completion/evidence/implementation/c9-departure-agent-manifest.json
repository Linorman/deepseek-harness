  "contracts": {
    "composition": "Actual Loader, original three Agents/Sessions, three tools and canonical Channels; only external keyless LLM is scripted",
    "acceptedFence": "Real original notification post held after accepted Team IO but before Native receipt; original request has no plans, actual active fence already exists, original assignment remains open and actual writer/Team activation remains charged and inventoried",
    "departure": "Independent actual director applies exact original payload; Native original reservation/quiescence/held Team+Channel cut atomically closes original assignment and old role authority; no entity/profile/cognition/identity replacement or termination",
    "personal": "retire=false actually continues private personal activity in original Session after departure, with accepted decision, actual model input and durable Session log",
    "retirement": "retire=true actual controller epochs have quiescedAt and original Native writer is released before committed original result; person remains active and not terminated",
    "future": "Result revokes original future authority ref; closedAuthorityRelationIds excludes the future ref; original interval/revision remain unchanged; after crossing original from=10 the permission directory still contains no original role rights",
    "handoff": "Actual original task/create has NativeTaskReceipt and Team pending record; departure returns handoff-required without closing assignment or releasing fenced reservation; connection.cancelTask creates canonical cancellation; original driver.reconcile settles via actual terminalTasks metadata",
    "newWork": "Actual administrator ordinary message uses all three tools for a distinct new task/create; new task remains pending with no lease or attempt; original task source/cancellation is unchanged, not moved to a successor or inherited debtor",
    "restore": "All20 independent cold processes across source/lib use zero model calls and validate retained original history plus actual canonical Team task books",
    "privacy": "Private original memory remains in original person Session and original prefix hashes; other actual model inputs do not contain it; private director rationale never enters target Session",
    "quotas": "Original catalog quotas unchanged; resident2/microsteps32/maxBytesPerPlan4096; no budget reset or hidden increase"
  },
