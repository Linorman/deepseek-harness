{
  "name": "@clocky/clocky-web-search-perplexity",
  "description": "Perplexity-backed search provider for Clocky web capability seam (ctx.web)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/web/web-search-perplexity"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/clocky-launch-environment": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-web": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "dependencies": {
    "@clocky/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-launch-environment": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-web": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
