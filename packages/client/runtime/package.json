{
  "name": "@clocky/clocky-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "clocky": {
    "client": {
      "inject": [
        "@clocky/clocky-client-connection",
        "@clocky/clocky-typert-registry",
        "@clocky/clocky-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-api-remotes": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-typert-protocol": "workspace:^",
    "@clocky/clocky-typert-registry": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-client-connection": "workspace:^",
    "@clocky/clocky-commands": "workspace:^",
    "@clocky/clocky-host-apiproxy": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-llm-retry": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-session-projection": "workspace:^",
    "@clocky/clocky-session-title": "workspace:^",
    "@clocky/clocky-tools": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-api-remotes": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-timeout": "workspace:^",
    "@clocky/clocky-typert-protocol": "workspace:^",
    "@clocky/clocky-typert-registry": "workspace:^",
    "@types/react": "~18.3.1",
    "@clocky/clocky-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-client-connection": "workspace:^",
    "@clocky/clocky-commands": "workspace:^",
    "@clocky/clocky-host-apiproxy": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-llm-retry": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-session-projection": "workspace:^",
    "@clocky/clocky-session-title": "workspace:^",
    "@clocky/clocky-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
