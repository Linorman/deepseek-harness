{
  "name": "@clocky/clocky-simulation-local",
  "description": "Durable simulation run local journal provider",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/simulation/simulation-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-simulation": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-sqlite": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-session": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-simulation": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-sqlite": "workspace:^",
    "@clocky/clocky-loader-smoke": "workspace:^",
    "@clocky/clocky-app-boot": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-session": "workspace:^"
  },
  "dependencies": {
    "@clocky/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "fast-json-stable-stringify": "^2.1.0"
  }
}
