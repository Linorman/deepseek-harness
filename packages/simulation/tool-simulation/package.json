{
  "name": "@clocky/clocky-tool-simulation",
  "description": "Prepared observations and deferred Simulation proposals",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/simulation/tool-simulation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./role": {
      "types": "./lib/types/role.d.ts",
      "default": "./lib/role.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/role.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-simulation": "workspace:^",
    "@clocky/clocky-simulation-team": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-simulation": "workspace:^",
    "@clocky/clocky-simulation-team": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-system-prompt": "workspace:^",
    "@clocky/clocky-scope": "workspace:^"
  },
  "dependencies": {}
}
