    },
    "./context-readers": {
      "types": "./lib/types/context-readers.d.ts",
      "default": "./lib/types/context-readers.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
