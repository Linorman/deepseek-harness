{
  "name": "@clocky/clocky-simulation",
  "description": "Durable simulation run registry and contracts",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/simulation/simulation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./time-types": {
      "types": "./lib/types/time-types.d.ts",
      "default": "./lib/types/time-types.js"
    },
    "./identities": {
      "types": "./lib/types/identities.d.ts",
      "default": "./lib/types/identities.js"
    },
    "./metrics-types": {
      "types": "./lib/types/metrics-types.d.ts",
      "default": "./lib/types/metrics-types.js"
    },
    "./checkpoint-diagnostics-types": {
      "types": "./lib/types/checkpoint-diagnostics-types.d.ts",
      "default": "./lib/types/checkpoint-diagnostics-types.js"
    },
    "./checkpoint-diagnostics-schema": {
      "types": "./lib/types/checkpoint-diagnostics-schema.d.ts",
      "default": "./lib/types/checkpoint-diagnostics-schema.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-brand": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-session": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-brand": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-session": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
