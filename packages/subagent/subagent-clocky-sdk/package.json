{
  "name": "@clocky/clocky-subagent-clocky-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Clocky runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/subagent/subagent-clocky-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-sdk-client": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-subagent": "workspace:^",
    "@clocky/clocky-subprocess": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "dependencies": {
    "@clocky/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis-plugin-loader": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-loader-smoke": "workspace:^",
    "@clocky/clocky-sdk-client": "workspace:^",
    "@clocky/clocky-sdk-protocol": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-subagent": "workspace:^",
    "@clocky/clocky-subprocess": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
