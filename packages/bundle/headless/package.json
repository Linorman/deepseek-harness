{
  "name": "@clocky/clocky-headless",
  "description": "The clocky one-shot bundle: a default Team runner over clocky-base with no Host, HTTP, or browser layer",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "clocky": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@clocky/clocky-agent-presets": "workspace:^",
    "@clocky/clocky-agent-runtime": "workspace:^",
    "@clocky/clocky-agent-runtime-in-process": "workspace:^",
    "@clocky/clocky-cmdline": "workspace:^",
    "@clocky/clocky-code-runtime-worker-thread": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-storage-sqlite": "workspace:^",
    "@clocky/clocky-team-activation-controller": "workspace:^",
    "@clocky/clocky-team-agent-client": "workspace:^",
    "@clocky/clocky-team-artifact": "workspace:^",
    "@clocky/clocky-team-artifact-local": "workspace:^",
    "@clocky/clocky-team-channel-basic": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-channel-summary": "workspace:^",
    "@clocky/clocky-team-channel-task-assignment": "workspace:^",
    "@clocky/clocky-team-channel-workflow": "workspace:^",
    "@clocky/clocky-team-closure-driver": "workspace:^",
    "@clocky/clocky-team-hub": "workspace:^",
    "@clocky/clocky-team-link": "workspace:^",
    "@clocky/clocky-team-link-local": "workspace:^",
    "@clocky/clocky-team-run": "workspace:^",
    "@clocky/clocky-team-scheduler-dag": "workspace:^",
    "@clocky/clocky-team-workspace": "workspace:^",
    "@clocky/clocky-team-workspace-recovery": "workspace:^",
    "@clocky/clocky-team-workspace-shared": "workspace:^",
    "@clocky/clocky-tool-team": "workspace:^",
    "@clocky/clocky-tool-team-goal": "workspace:^",
    "@clocky/clocky-tool-team-task": "workspace:^",
    "@clocky/schemastery": "workspace:^",
    "commander": "^15.0.0",
    "@clocky/clocky-team-channel-admission": "workspace:^",
    "@clocky/clocky-team-placement-default": "workspace:^",
    "@clocky/clocky-team-delegation": "workspace:^"
  },
  "peerDependencies": {
    "@clocky/cordis-plugin-loader": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis-plugin-loader": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
