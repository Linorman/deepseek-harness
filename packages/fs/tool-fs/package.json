{
  "name": "@clocky/clocky-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Clocky filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@clocky/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-fs": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-sandbox": "workspace:^",
    "@clocky/clocky-sandbox-policy": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-system-prompt": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-loop": "workspace:^",
    "@clocky/clocky-agent-loop-testkit": "workspace:^",
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-fs": "workspace:^",
    "@clocky/clocky-fs-local": "workspace:^",
    "@clocky/clocky-fs-observation-policy": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-sandbox": "workspace:^",
    "@clocky/clocky-sandbox-policy": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-system-prompt": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
