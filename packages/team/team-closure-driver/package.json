{
  "name": "@clocky/clocky-team-closure-driver",
  "description": "Restart-safe provider-routed Team closure recovery driver",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/team/team-closure-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./hub": {
      "types": "./lib/types/hub.d.ts",
      "default": "./lib/hub.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/registry.js",
    "lib/hub.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clocky/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-activation-controller": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-agent-runtime": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-activation-controller": "workspace:^",
    "@clocky/clocky-team-hub": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
