{
  "name": "@clocky/clocky-team-hub",
  "description": "Authoritative local Team journal and channel-WAL provider with recovery and cursor watches",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/team/team-hub"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clocky/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-storage-sqlite": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
