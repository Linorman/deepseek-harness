    "@clocky/clocky-activation-supervisor": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-runtime": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-workspace": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-activation-supervisor": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-loop": "workspace:^",
