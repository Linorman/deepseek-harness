{
  "name": "@clocky/clocky-team-channel-admission",
  "description": "Durable channel invitation recovery and endpoint admission",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/team/team-channel-admission"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./principal": {
      "types": "./lib/types/principal.d.ts",
      "default": "./lib/principal.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/principal.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clocky/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-team-human-actor": "workspace:^",
    "@clocky/clocky-product-principal": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-channel-basic": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-team-human-actor": "workspace:^",
    "@clocky/clocky-product-principal": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-channel-basic": "workspace:^"
  }
}
