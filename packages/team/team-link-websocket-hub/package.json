{
  "name": "@clocky/clocky-team-link-websocket-hub",
  "description": "Authenticated WebSocket Hub listener for remote activation-bound Team Link frames",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/team/team-link-websocket-hub"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clocky/schemastery": "workspace:^",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@clocky/clocky-host-webserver": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-link": "workspace:^",
    "@clocky/clocky-team-workspace": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-host-webserver": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-storage-sqlite": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-channel-task-assignment": "workspace:^",
    "@clocky/clocky-team-hub": "workspace:^",
    "@clocky/clocky-team-link": "workspace:^",
    "@clocky/clocky-team-link-websocket": "workspace:^",
    "@clocky/clocky-team-workspace": "workspace:^",
    "@clocky/cordis": "workspace:^",
    "@types/ws": "^8.18.1"
  }
}
