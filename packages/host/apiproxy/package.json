{
  "name": "@clocky/clocky-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-default-model": "workspace:^",
    "@clocky/clocky-api-remotes": "workspace:^",
    "@clocky/clocky-brand": "workspace:^",
    "@clocky/clocky-commands": "workspace:^",
    "@clocky/clocky-credentials": "workspace:^",
    "@clocky/clocky-goal": "workspace:^",
    "@clocky/clocky-host-directory-picker": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-native-command": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-session-persistence": "workspace:^",
    "@clocky/clocky-session-projection": "workspace:^",
    "@clocky/clocky-session-projection-cache": "workspace:^",
    "@clocky/clocky-session-query": "workspace:^",
    "@clocky/clocky-session-title": "workspace:^",
    "@clocky/clocky-settings": "workspace:^",
    "@clocky/clocky-skill": "workspace:^",
    "@clocky/clocky-subagent": "workspace:^",
    "@clocky/clocky-jobs": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/clocky-user-questions": "workspace:^",
    "@clocky/clocky-workspace": "workspace:^",
    "@clocky/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-agent-presets": "workspace:^",
    "@clocky/clocky-cordis-host-runner": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^"
  },
  "devDependencies": {
    "@clocky/cordis": "workspace:^",
    "@clocky/clocky-agent-presets": "workspace:^",
    "@clocky/clocky-cordis-host-runner": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-domain": "workspace:^",
    "@clocky/clocky-typert-protocol": "workspace:^",
    "@clocky/clocky-typert-registry": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
