{
  "name": "@clocky/clocky-llm-pi-ai",
  "description": "Generic pi-ai multi-provider adapter for the LLM seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-authorization": "workspace:^",
    "@clocky/clocky-credentials": "workspace:^",
    "@clocky/clocky-launch-environment": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-settings": "workspace:^",
    "@clocky/clocky-timeout": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@clocky/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-authorization": "workspace:^",
    "@clocky/clocky-credentials": "workspace:^",
    "@clocky/clocky-launch-environment": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-settings": "workspace:^",
    "@clocky/clocky-timeout": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
