{
  "name": "@clocky/clocky-acp",
  "description": "Automation-only Agent Client Protocol server for driving Clocky agents over JSON-RPC stdio",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@clocky/schemastery": "workspace:^",
    "@clocky/clocky-team-channel-admission": "workspace:^"
  },
  "peerDependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-default-model": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-run": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-attachment": "workspace:^",
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-agent-default-model": "workspace:^",
    "@clocky/clocky-agent-loop": "workspace:^",
    "@clocky/clocky-agent-loop-testkit": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-session-persistence-jsonl": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-team-activation-controller": "workspace:^",
    "@clocky/clocky-team-agent-client": "workspace:^",
    "@clocky/clocky-team-channel-direct": "workspace:^",
    "@clocky/clocky-team-closure-driver": "workspace:^",
    "@clocky/clocky-team-hub": "workspace:^",
    "@clocky/clocky-team-link": "workspace:^",
    "@clocky/clocky-team-link-local": "workspace:^",
    "@clocky/clocky-team-run": "workspace:^",
    "@clocky/clocky-tool-team": "workspace:^",
    "@clocky/clocky-tools": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
