{
  "name": "@clocky/clocky-activation-supervisor-http",
  "description": "Authenticated HTTP supervision with durable SDK process ownership",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/agent-runtime/activation-supervisor-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./endpoint": {
      "types": "./lib/types/endpoint.d.ts",
      "default": "./lib/endpoint.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/endpoint.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/clocky-activation-supervisor": "workspace:^",
    "@clocky/clocky-agent-runtime-sdk": "workspace:^",
    "@clocky/clocky-subprocess-local": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-activation-supervisor": "workspace:^",
    "@clocky/clocky-agent-runtime-sdk": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-storage": "workspace:^",
    "@clocky/clocky-storage-json": "workspace:^",
    "@clocky/clocky-storage-log": "workspace:^",
    "@clocky/clocky-subprocess-local": "workspace:^",
    "@clocky/clocky-team": "workspace:^",
    "@clocky/cordis": "workspace:^",
    "@clocky/cordis-plugin-include": "workspace:^",
    "@clocky/cordis-plugin-loader": "workspace:^"
  },
  "dependencies": {
    "@clocky/schemastery": "workspace:^",
    "zod": "^4.4.3"
  }
}
