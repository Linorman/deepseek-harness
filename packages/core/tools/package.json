{
  "name": "@clocky/clocky-tools",
  "description": "Tool registry and execution pipeline for Clocky",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linorman/clocky.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-code-runtime": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-scope": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-system-prompt": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  },
  "dependencies": {
    "@clocky/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@clocky/clocky-agent": "workspace:^",
    "@clocky/clocky-code-runtime": "workspace:^",
    "@clocky/clocky-invariants": "workspace:^",
    "@clocky/clocky-llm": "workspace:^",
    "@clocky/clocky-scope": "workspace:^",
    "@clocky/clocky-session": "workspace:^",
    "@clocky/clocky-system-prompt": "workspace:^",
    "@clocky/clocky-user-approval": "workspace:^",
    "@clocky/cordis": "workspace:^"
  }
}
