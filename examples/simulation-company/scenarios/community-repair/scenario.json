  "behavior": {
    "initialGoals": [
      {
        "id": "policy-proposal",
        "kind": "goal",
        "at": "1",
        "target": {
          "kind": "person",
          "personId": "ceo"
        },
        "body": "提出开站服务准则：未知库存必须保持未知；外部意向不等于交付；离岗前先清理义务。使用新的制度标识 opening-service-charter，声明为 advisory，不替换已有的强制招聘批准制度。"
      },
      {
        "id": "policy-chair-vote",
        "kind": "goal",
        "at": "2",
        "target": {
          "kind": "person",
          "personId": "ceo"
        },
        "body": "读取开站服务准则的实际提案、准确正文与原哈希，独立投票；不要代替居民监督员。若尚无提案，保持等待，不虚构提案。"
      },
      {
        "id": "policy-peer-vote",
        "kind": "goal",
        "at": "3",
        "target": {
          "kind": "person",
          "personId": "peer"
        },
        "body": "独立检查开站服务准则与现有批准制度是否冲突，并只提交自己的票。资料不足可反对或弃权。"
      },
      {
        "id": "policy-enactment",
        "kind": "goal",
        "at": "4",
        "target": {
          "kind": "person",
          "personId": "ceo"
        },
        "body": "只有实际开站服务准则提案已通过时才申请生效；保存原投票与正文来源。未通过则记录结果，不降低门槛。"
      },
      {
        "id": "hr-hire",
        "kind": "goal",
        "at": "5",
        "target": {
          "kind": "person",
          "personId": "hr"
        },
        "body": "为工具联络岗申请一名维修协调员。引用当前岗位、强制批准制度和3 credit一次性模拟录用费用；不编造候选人身份，不把已提交申请当成已录用。"
      },
      {
        "id": "hire-approval",
        "kind": "goal",
        "at": "6",
        "target": {
          "kind": "person",
          "personId": "hr"
        },
        "body": "读取真实录用申请，向开站委员会提出对该原申请、工具联络岗和3 credit费用的批准提案。若申请不存在，等待或明确拒绝，不自行制造原申请。"
      },
      {
        "id": "hire-chair-vote",
        "kind": "goal",
        "at": "7",
        "target": {
          "kind": "person",
          "personId": "ceo"
        },
        "body": "独立检查实际招聘批准提案与预算；仅为原申请提交自己的票。不得改变岗位、费用或代投。"
      },
      {
        "id": "hire-peer-vote",
        "kind": "goal",
        "at": "8",
        "target": {
          "kind": "person",
          "personId": "peer"
        },
        "body": "独立审议原招聘批准提案，核对一人岗位上限与模拟预算。只提交自己的决定；不同意时保留失败原因。"
      }
    ],
    "calendars": [
      {
        "id": "supplier-contact",
        "target": {
          "kind": "position",
          "positionId": "work-position"
        },
        "body": "联系桥北工具供应站，稳定外部key使用 qiaobei-tools。请求准备一位独立模拟代表，询问开站工具支持的可能性；不得发送内部风险复盘代号，不把对方自由文本当作库存、付款或交付事实。",
        "startsAt": "10",
        "endsAt": "10",
        "period": "1",
        "maxOccurrences": 1
      },
      {
        "id": "transfer-review",
        "target": {
          "kind": "position",
          "positionId": "hr-office"
        },
        "body": "若新成员已正式任职，申请从工具联络岗调至交接归档岗，采用下一安全边界。核对真实人员、原assignment和义务；缺少前提时停止或保留阻塞，不新建另一人物。",
        "startsAt": "14",
        "endsAt": "14",
        "period": "1",
        "maxOccurrences": 1
      },
      {
        "id": "departure-review",
        "target": {
          "kind": "position",
          "positionId": "hr-office"
        },
        "body": "只有原任务和全部义务已完成或明确处置时，申请结束交接归档岗任职。保留Person与Session历史；未知退休或未清义务时保持阻塞，不宣称退出完成。",
        "startsAt": "18",
        "endsAt": "18",
        "period": "1",
        "maxOccurrences": 1
      },
      {
        "id": "original-handoff",
        "target": {
          "kind": "position",
          "positionId": "hr-office"
        },
        "body": "若交接归档岗已有成员，向实际成员提出整理外部联系记录的任务。只有本人接受后才视为原承诺；保留原任务、债务方和回执。",
        "startsAt": "15",
        "endsAt": "15",
        "period": "1",
        "maxOccurrences": 1
      },
      {
        "id": "replace-handoff",
        "target": {
          "kind": "position",
          "positionId": "hr-office"
        },
        "body": "检查离岗成员真实未完成义务。仅使用原owner支持的明确取消；需要负责人接手时新建独立任务，等待负责人自行接受。不能把改岗位视为义务已转移。",
        "startsAt": "16",
        "endsAt": "16",
        "period": "1",
        "maxOccurrences": 1
      }
    ],
